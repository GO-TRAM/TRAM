{
  "uid": "tram-logs",
  "title": "Logs through Tram",
  "description": "Logs that the OTLP clients send to Tram and Tram forwards to OpenObserve. DEBUG logs are dropped by Tram's logs filter stage, so only the checkout service shows up.",
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "schemaVersion": 39,
  "templating": {
    "list": []
  },
  "links": [
    {
      "title": "Metrics through Tram",
      "type": "link",
      "url": "/d/tram-metrics"
    },
    {
      "title": "Traces through Tram",
      "type": "link",
      "url": "/d/tram-traces"
    },
    {
      "title": "Tram internals",
      "type": "link",
      "url": "/d/tram-internals"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Log records by service",
      "description": "Records per histogram interval, which OpenObserve picks from the time range.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "openobserve",
        "uid": "openobserve"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "transformations": [
        {
          "id": "partitionByValues",
          "options": {
            "fields": [
              "service_name"
            ],
            "keepFields": false
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "openobserve",
            "uid": "openobserve"
          },
          "organization": "default",
          "stream": "tram_logs",
          "sqlMode": true,
          "displayMode": "graph",
          "query": "SELECT histogram(_timestamp) AS zo_sql_key, service_name, count(*) AS records FROM \"tram_logs\" GROUP BY zo_sql_key, service_name ORDER BY zo_sql_key"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Log records by severity",
      "description": "Only INFO arrives: the DEBUG logs of the debug-noise service never leave Tram.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "openobserve",
        "uid": "openobserve"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "transformations": [
        {
          "id": "partitionByValues",
          "options": {
            "fields": [
              "severity"
            ],
            "keepFields": false
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "openobserve",
            "uid": "openobserve"
          },
          "organization": "default",
          "stream": "tram_logs",
          "sqlMode": true,
          "displayMode": "graph",
          "query": "SELECT histogram(_timestamp) AS zo_sql_key, severity, count(*) AS records FROM \"tram_logs\" GROUP BY zo_sql_key, severity ORDER BY zo_sql_key"
        }
      ]
    },
    {
      "id": 3,
      "type": "logs",
      "title": "Log lines",
      "description": "The latest 200 log lines, queried with SQL through the Infinity plugin, since the OpenObserve plugin only returns aggregations in dashboards.",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 14
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "openobserve-sql"
      },
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "openobserve-sql"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "/_search?type=logs",
          "url_options": {
            "method": "POST",
            "data": "{\"query\":{\"sql\":\"SELECT _timestamp / 1000 AS time, body, service_name, severity FROM \\\"tram_logs\\\" ORDER BY _timestamp DESC LIMIT 200\",\"start_time\":${__from}000,\"end_time\":${__to}000,\"from\":0,\"size\":200}}",
            "body_type": "raw",
            "body_content_type": "application/json"
          },
          "root_selector": "hits",
          "columns": [
            {
              "selector": "time",
              "text": "time",
              "type": "timestamp_epoch"
            },
            {
              "selector": "body",
              "text": "body",
              "type": "string"
            },
            {
              "selector": "service_name",
              "text": "service_name",
              "type": "string"
            },
            {
              "selector": "severity",
              "text": "level",
              "type": "string"
            }
          ]
        }
      ]
    }
  ]
}
