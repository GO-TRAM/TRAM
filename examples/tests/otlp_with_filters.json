{
  "stream": {
    "name": "otlp_with_filters",
    "source": {
      "name": "otlp_source",
      "type": "otlp",
      "spec": {
        "http_port": 4318
      }
    },
    "stages": [
      {
        "name": "customer_filter",
        "type": "filter",
        "from": "otlp_source",
        "spec": {
          "driver": "cel",
          "cel": {
            "logs": "record.attributes.exists(attr, attr.key == 'customer' && attr.value.string_value == 'A')"
          }
        }
      }
    ],
    "sinks": [
      {
        "name": "customer_a_sink",
        "type": "otlp",
        "from": "customer_filter",
        "spec": {
          "url": "http://customer-a-telemetry:4318",
          "headers": {
            "X-Customer": "A"
          }
        }
      }
    ],
    "tests": [
      {
        "name": "keeps logs of customer A",
        "input": {
          "logs": {
            "resourceLogs": [
              {
                "scopeLogs": [
                  {
                    "logRecords": [
                      {
                        "attributes": [{ "key": "customer", "value": { "stringValue": "A" } }],
                        "body": { "stringValue": "hello" }
                      }
                    ]
                  }
                ]
              }
            ]
          }
        },
        "expect": {
          "customer_a_sink": {
            "logs": {
              "resourceLogs": [
                {
                  "scopeLogs": [
                    {
                      "logRecords": [
                        {
                          "attributes": [{ "key": "customer", "value": { "stringValue": "A" } }],
                          "body": { "stringValue": "hello" }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          }
        }
      },
      {
        "name": "drops logs of other customers",
        "input": {
          "logs": {
            "resourceLogs": [
              {
                "scopeLogs": [
                  {
                    "logRecords": [
                      {
                        "attributes": [{ "key": "customer", "value": { "stringValue": "B" } }],
                        "body": { "stringValue": "hello" }
                      }
                    ]
                  }
                ]
              }
            ]
          }
        },
        "expect": { "customer_a_sink": "drop" }
      }
    ]
  }
}
