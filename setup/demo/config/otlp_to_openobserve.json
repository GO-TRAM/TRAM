{
  "stream": {
    "source": {
      "name": "otlp",
      "type": "otlp",
      "spec": {
        "http_port": 4318
      }
    },
    "stages": [
      {
        "name": "logs",
        "type": "cel_filter",
        "from": "otlp",
        "spec": {
          "logs": "record.severity_number >= 9",
          "metrics": "false",
          "traces": "false"
        }
      },
      {
        "name": "batch-logs",
        "type": "batch",
        "from": "logs",
        "spec": {
          "max_records": 100,
          "timeout": "5s"
        }
      },
      {
        "name": "metrics",
        "type": "cel_filter",
        "from": "otlp",
        "spec": {
          "logs": "false",
          "metrics": "!metric.name.startsWith('debug.')",
          "traces": "false"
        }
      },
      {
        "name": "batch-metrics",
        "type": "batch",
        "from": "metrics",
        "spec": {
          "max_records": 10,
          "timeout": "1s"
        }
      },
      {
        "name": "traces",
        "type": "cel_filter",
        "from": "otlp",
        "spec": {
          "logs": "false",
          "metrics": "false",
          "traces": "!resource.attributes.exists(attr, attr.key == 'service.name' && attr.value.string_value == 'debug-noise')"
        }
      },
      {
        "name": "batch-traces",
        "type": "batch",
        "from": "traces",
        "spec": {
          "max_records": 5,
          "timeout": "10s"
        }
      }
    ],
    "sinks": [
      {
        "name": "openobserve-logs",
        "type": "otlp",
        "from": "batch-logs",
        "spec": {
          "url": "http://openobserve:5080/api/default",
          "headers": {
            "Authorization": "Basic cm9vdEBleGFtcGxlLmNvbTpDb21wbGV4cGFzcyMxMjM=",
            "stream-name": "tram_logs"
          }
        }
      },
      {
        "name": "openobserve-metrics",
        "type": "otlp",
        "from": "batch-metrics",
        "spec": {
          "url": "http://openobserve:5080/api/default",
          "headers": {
            "Authorization": "Basic cm9vdEBleGFtcGxlLmNvbTpDb21wbGV4cGFzcyMxMjM="
          }
        }
      },
      {
        "name": "openobserve-traces",
        "type": "otlp",
        "from": "batch-traces",
        "spec": {
          "url": "http://openobserve:5080/api/default",
          "headers": {
            "Authorization": "Basic cm9vdEBleGFtcGxlLmNvbTpDb21wbGV4cGFzcyMxMjM=",
            "stream-name": "tram_traces"
          }
        }
      }
    ]
  }
}
