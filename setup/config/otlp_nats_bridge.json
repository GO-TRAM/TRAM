{
  "stream": {
    "name": "otlp_nats_bridge",
    "source": {
      "name": "nats_source",
      "type": "broker",
      "spec": {
        "driver": "nats",
        "signal": "logs",
        "workers": 4,
        "nats": {
          "url": "nats://localhost:4222",
          "subject": "telemetry.*",
          "stream": "input-stream",
          "durable": "tram-otlp-bridge"
        }
      }
    },
    "stages": [
      {
        "name": "batch_stage",
        "type": "batch",
        "from": "nats_source",
        "spec": {
          "max_records": 2000,
          "timeout": "1s"
        }
      }
    ],
    "sinks": [
      {
        "name": "otlp_sink",
        "type": "otlp",
        "from": "batch_stage",
        "spec": {
          "url": "http://central-telemetry:4318",
          "timeout": "30s",
          "headers": {
            "X-Bridge": "nats-to-otlp",
            "X-Source-Stream": "input-stream"
          }
        }
      }
    ]
  }
}
