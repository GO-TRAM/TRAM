{
  "stream": {
    "name": "otlp_multi_sink",
    "source": {
      "name": "otlp_source",
      "type": "otlp",
      "spec": {
        "http_port": 4318
      }
    },
    "stages": [
      {
        "name": "split_logs",
        "type": "cel_filter",
        "from": "otlp_source",
        "spec": {
          "logs": "record.attributes.exists(attr, attr.key == 'level' && (attr.value.string_value == 'ERROR' || attr.value.string_value == 'WARN'))"
        }
      }
    ],
    "sinks": [
      {
        "name": "error_logs_sink",
        "type": "otlp",
        "from": "split_logs",
        "spec": {
          "url": "http://error-log-collector:4318",
          "headers": {
            "X-Log-Type": "errors"
          }
        }
      },
      {
        "name": "all_sink",
        "type": "otlp",
        "from": "otlp_source",
        "spec": {
          "url": "http://all-log-collector:4318",
          "headers": {
            "X-Log-Type": "all"
          }
        }
      }
    ]
  }
}
