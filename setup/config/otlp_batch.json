{
  "stream": {
    "name": "otlp_batch",
    "source": {
      "name": "otlp_source",
      "type": "otlp",
      "spec": {
        "http_port": 4318
      }
    },
    "stages": [
      {
        "name": "batch_stage",
        "type": "batch",
        "from": "otlp_source",
        "spec": {
          "max_records": 1000,
          "timeout": "200ms"
        }
      }
    ],
    "sinks": [
      {
        "name": "otlp_sink",
        "type": "otlp",
        "from": "batch_stage",
        "spec": {
          "url": "http://telemetry-collector:4318",
          "timeout": "30s"
        }
      }
    ]
  }
}