{
  "stream": {
    "name": "otlp_secure",
    "source": {
      "name": "otlp_source",
      "type": "otlp",
      "spec": {
        "http_port": 4318
      }
    },
    "stages": [],
    "sinks": [
      {
        "name": "Secure_OTLP_Sink",
        "type": "otlp",
        "from": "otlp_source",
        "spec": {
          "url": "https://telemetry-collector.example.com:443",
          "timeout": "10s",
          "headers": {
            "Authorization": "Bearer your-api-token-here",
            "Content-Type": "application/protobuf",
            "X-Environment": "production"
          }
        }
      }
    ]
  }
}