{
  "stream": {
    "name": "benchmark_otlp_batch_nats",
    "source": {
      "name": "otlp_source",
      "type": "otlp",
      "spec": {
        "http_port": 4318
      }
    },
    "stages": [
      {
        "name": "batch_stage",
        "type": "batch",
        "from": "otlp_source",
        "spec": {
          "max_records": 1000,
          "timeout": "10ms"
        }
      }
    ],
    "sinks": [
      {
        "name": "nats_sink",
        "type": "broker",
        "from": "batch_stage",
        "spec": {
          "driver": "nats",
          "nats": {
            "url": "nats://localhost:4222"
          },
          "destination": {
            "logs": "'benchmark.' + logs.resource_logs[0].resource.attributes.get_attr('service.name')",
            "metrics": "'benchmark.' + metrics.resource_metrics[0].resource.attributes.get_attr('service.name')",
            "traces": "'benchmark.' + traces.resource_spans[0].resource.attributes.get_attr('service.name')"
          }
        }
      }
    ]
  }
}
