{
  "stream": {
    "name": "otlp_cel_nats",
    "source": {
      "name": "otlp_source",
      "type": "otlp",
      "spec": {
        "http_port": 4318
      }
    },
    "stages": [
      {
        "name": "cel_stage",
        "type": "cel_validator",
        "from": "otlp_source",
        "spec": {
          "logs:": "logs.resource_logs.all(resLog, resLog.scope_logs.all(scopeLog, schopeLog.log_records.exist(record, record.attributes.exists(attr, attr.key=='service.name'))))",
          "metrics:": "metrics.resource_metrics.all(resMetric, resMetric.resource.attributes.exists(attr, attr.key == 'service.name')",
          "on_mismatch": "reject",
          "traces:": "traces.resource_spans.all(resSpan, respSPan.resource.attributes.exists(attr, attr.key = 'service.name'))"
        }
      }
    ],
    "sinks": [
      {
        "name": "nats_sink",
        "type": "nats",
        "from": "cel_stage",
        "spec": {
          "stream": "tram-stream",
          "subject": {
            "logs": "'logs.audit.' + logs.resource_logs[0].resource.attributes.get_attr('service.name')",
            "metrics": "'metrics.' + metrics.resource_metrics[0].resource.attributes.get_attr('service.name')",
            "register": [
              "logs.audit.*",
              "metrics.*",
              "traces.*"
            ],
            "traces": "'traces.' + traces.resource_spans[0].resource.attributes.get_attr('service.name')"
          },
          "url": "nats://localhost:4222"
        }
      }
    ]
  }
}